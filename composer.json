{
	"name": "hypejunction/cropper",
	"version": "1.1.0",
	"type": "elgg-plugin",
	"description": "Cropper form input for Elgg",
	"homepage": "https://github.com/hypeJunction/Elgg-cropper",
	"keywords": [
		"elgg",
		"plugin",
		"image",
		"crop",
		"cropper"
	],
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.2",
		"composer/installers": "^2.0",
		"elgg/elgg": "^5.0",
		"bower-asset/cropper": "~2.1"
	},
	"repositories": [
		{
			"type": "composer",
			"url": "https://asset-packagist.org"
		}
	],
	"config": {
		"allow-plugins": {
			"composer/installers": true
		}
	},
	"extra": {
		"installer-name": "cropper",
		"elgg-plugin": {
			"id": "cropper"
		}
	}
}
