{
    "name": "hypejunction/cropper",
    "version": "3.0.0",
    "type": "elgg-plugin",
    "description": "Cropper form input for Elgg",
    "homepage": "http://hypejunction.com",
    "keywords": [
        "elgg",
        "plugin",
        "image",
        "crop",
        "cropper"
    ],
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Ismayil Khayredinov",
            "email": "info@hypejunction.com"
        }
    ],
    "require": {
        "composer/installers": "^2.0",
        "php": ">=7.4",
        "elgg/elgg": "^3.0",
        "bower-asset/cropper": "~2.1"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    },
    "extra": {
        "installer-name": "cropper",
        "elgg-plugin": {
            "id": "cropper"
        }
    }
}
